APP_NAME="La Buena Mesa API"
APP_ENV=local
APP_KEY=base64:9C621NwcmiCabcNHGp+bHue3ZaiBHa+ujQfLS3Y9yIo=
APP_DEBUG=true
APP_TIMEZONE=America/El_Salvador
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de datos
# Por defecto usa SQLite (el archivo database/database.sqlite ya viene incluido
# en el repo, vacío) para que "php artisan migrate --seed" funcione sin
# instalar MySQL primero.
#DB_CONNECTION=sqlite

#Para usar MySQL en su lugar, comenta la línea de arriba y descomenta esto:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=la_buena_mesa
DB_USERNAME=root
DB_PASSWORD=

# file/sync evitan depender de tablas extra (cache, sessions, jobs) que
# este proyecto no migra, ya que no son necesarias para la actividad.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
